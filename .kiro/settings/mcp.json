{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ],
      "autoApprove": [
        "search-docs",
        "database-schema",
        "application-info",
        "read-log-entries",
        "get-absolute-url"
      ]
    }
  }
}